# =====================================================================
# 生产环境（docker-compose.prod.yml）变量模板。
# 用法：
#   cp .env.prod.example .env.prod
#   # 修改下面的 RDS / 镜像地址 / 资源上限
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =====================================================================

# ===== 镜像（必填） =====
IMAGE_NAME=registry.cn-hangzhou.aliyuncs.com/<your-namespace>/ub-rag-core
IMAGE_TAG=0.1.0
COMPOSE_PROJECT_NAME=ub-rag-core

# ===== 端口（仅本机回环暴露，由前置 SLB / Nginx 转发） =====
APP_PORT=8000

# ===== RDS 数据库连接（必填） =====
DATABASE_URL=postgresql+asyncpg://rag:CHANGE_ME@pgm-xxxxxxxx.pg.rds.aliyuncs.com:5432/rag

# ===== 模型 / 推理 =====
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
HF_ENDPOINT=https://hf-mirror.com
DEVICE=cpu
USE_FP16=false

# ===== 模型缓存（宿主机目录，建议挂 NAS / SSD） =====
MODEL_CACHE_HOST_DIR=/data/ub-rag-core/model-cache

# ===== 资源上限（按实例规格调整） =====
APP_CPU_LIMIT=4
APP_MEM_LIMIT=8g
APP_CPU_RESERVE=2
APP_MEM_RESERVE=4g

# ===== 行为开关 =====
LOG_LEVEL=INFO
# 业务容器无状态，不跑迁移。部署前用一次性容器执行：
#   make prod-migrate
# 等价于：
#   docker compose -f docker-compose.prod.yml --env-file .env.prod \
#       run --rm app alembic upgrade head
RUN_MIGRATIONS=false
# uvicorn worker 数。每个 worker 各自加载模型（5–6GB），通常 1 即可，
# 真要扩并发用横向扩多副本（k8s replicas / 多机部署）。
WORKERS=1
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DEFAULT_TOP_K=20
DEFAULT_RERANK_TOP_K=5
