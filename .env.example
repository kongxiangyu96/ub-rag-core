# ===== App =====
APP_NAME=ub-rag-core
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ===== Database (async URL, use postgresql+asyncpg://) =====
# Local docker-compose default:
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# Alibaba Cloud RDS PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@pgm-xxxxxxxx.pg.rds.aliyuncs.com:5432/rag

# ===== Embedding / Reranker =====
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Local cache directory for HF models (mount as volume in docker)
MODEL_CACHE_DIR=/app/.model_cache

# Use HF mirror for faster download in mainland China
HF_ENDPOINT=https://hf-mirror.com

# Inference device: cpu | cuda
DEVICE=cpu
USE_FP16=false

# ===== Chunking =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ===== Retrieval =====
DEFAULT_TOP_K=20
DEFAULT_RERANK_TOP_K=5
