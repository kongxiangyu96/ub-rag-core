# =====================================================================
# 这一份文件同时被以下两边读取：
#   1. 应用本身：pydantic-settings 在容器内读取（小写名）
#   2. docker-compose：compose 通过 ${VAR:-default} 把同名变量注入到容器
# 所以变量名以大写为准，应用侧 case_sensitive=False 自动匹配。
# 复制为 .env 后按需修改即可。
# =====================================================================

# ===== Compose / Image =====
# 容器名前缀；多实例部署时改成不同的值即可隔离
COMPOSE_PROJECT_NAME=ub-rag-core
# 本地构建/打 tag 用，生产请改成 ACR 镜像地址
IMAGE_NAME=ub-rag-core
IMAGE_TAG=latest

# 宿主机暴露端口
APP_PORT=8000
POSTGRES_PORT=5432

# ===== App =====
APP_NAME=ub-rag-core
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# uvicorn worker 数。每个 worker 各自加载一份模型（约 5–6GB），不要随便调大。
WORKERS=1

# ===== Postgres（仅本地 docker-compose 起 db 时用） =====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# ===== Database 连接串（必须用 postgresql+asyncpg://） =====
# 本地 compose：app 容器内通过服务名 db 访问
DATABASE_URL=postgresql+asyncpg://rag:rag@db:5432/rag
# 不用容器、本地直跑应用时：
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# 阿里云 RDS PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@pgm-xxxxxxxx.pg.rds.aliyuncs.com:5432/rag

# ===== Embedding / Reranker =====
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# 模型权重缓存目录（容器内路径）；docker-compose 已经挂了 named volume 持久化
MODEL_CACHE_DIR=/app/.model_cache

# 国内拉模型加速
HF_ENDPOINT=https://hf-mirror.com

# 推理设备：cpu | cuda
DEVICE=cpu
USE_FP16=false

# ===== Chunking =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ===== Retrieval =====
DEFAULT_TOP_K=20
DEFAULT_RERANK_TOP_K=5

# ===== 容器入口 =====
# 业务容器启动时是否自动跑 alembic upgrade head。
# - 本地单副本：true 方便
# - 生产多副本：必须 false，迁移由部署流水线/单独的一次性容器执行：
#     docker compose run --rm app alembic upgrade head
RUN_MIGRATIONS=true
